{
  "name": "bbps",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.5%",
    "ios_saf >= 15.4",
    "safari >= 15.4",
    "Firefox ESR",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "prebuild": "node scripts/responsive-images.mjs",
    "build": "next build && node scripts/generate-feed.mjs && node scripts/strip-preview.mjs",
    "start": "serve out",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "typecheck": "tsc --noEmit",
    "check": "biome check && bun run typecheck && bun run check:theme && bun run check:spacing && bun run check:deprecations",
    "download-assets": "node scripts/download-assets.mjs",
    "migrate-blog": "node scripts/migrate-blog.mjs",
    "check:data": "node scripts/gen-entities.mjs --check && node scripts/gen-command-notes.mjs --check",
    "check:theme": "node scripts/check-theme-parity.mjs",
    "check:spacing": "node scripts/check-spacing.mjs",
    "check:deprecations": "node scripts/check-deprecations.mjs",
    "format": "biome format --write"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.3.1",
    "artalk": "^2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "next": "^16.3.5",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-xml-parser": "^5.11.1",
    "serve": "^14.2.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "undici": "^8.13.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
