/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; object-src 'none'; img-src 'self' data: blob: https://*.30hb.cn https://*.music.126.net https://*.gravatar.com https://cdn.jsdelivr.net; media-src 'self' blob: https://*.saop.cc https://*.music.126.net https://r2.30hb.cn https://api.i-meto.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://webapi.30hb.cn https://*.30hb.cn https://*.saop.cc https://*.music.126.net https://api.i-meto.com https://cdn.jsdelivr.net

# 文件名带内容哈希，内容永不改变 —— 改了内容文件名就变。
# Cloudflare Pages 默认给所有资源 max-age=14400,must-revalidate，
# 于是回访者每 4 小时就要为二十来个 JS/CSS/字体各发一次条件请求。
# 这些文件可以放心 immutable，浏览器连 304 都不用问。
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 自毁 Service Worker 不能被缓存，否则老用户拿不到它
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
